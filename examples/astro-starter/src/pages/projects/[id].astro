---
export const prerender = false;

import { getLiveCollection, getLiveEntry } from 'astro:content';
import { PROPCORE_KEY, PROPCORE_SITE } from 'astro:env/server';
import { propcoreStacking } from '@propcore/astro';
import Availability from '../../components/Availability.astro';
import UnitCard from '../../components/UnitCard.astro';
import Base from '../../layouts/Base.astro';

const id = Astro.params.id;
if (!id) return new Response(null, { status: 404 });
const [liveProject, liveUnits, buildings] = await Promise.all([
  getLiveEntry('liveProjects', id),
  getLiveCollection('availability', { project_id: id }),
  propcoreStacking({ site: PROPCORE_SITE, key: PROPCORE_KEY }, id).catch(() => null),
]);
// Astro reports a loader's `undefined` (our 404) as LiveEntryNotFoundError; its own `.is()` checks the name.
if (liveProject.error?.name === 'LiveEntryNotFoundError')
  return new Response(null, { status: 404 });
const project = liveProject.entry;
const units = liveUnits.entries;
if (!project || !units || !buildings) return new Response('Catalog unavailable', { status: 502 });
// Counts come from the stacking plan: it lists every unit of the project, while `units`
// holds only what the source's Views expose.
const cells = buildings.flatMap((b) => b.floors.flatMap((f) => f.cells)).filter((c) => c.unit_id);
const total = cells.length;
const available = cells.filter((c) => c.status.state === 'available').length;
const rooms = Astro.url.searchParams.get('rooms');
const shown = rooms ? units.filter((u) => String(u.data.rooms) === rooms) : units;
const roomOptions = [
  ...new Set(units.map((u) => u.data.rooms).filter((r): r is number => r != null)),
].sort((a, b) => a - b);
---
<Base title={project.data.name}>
  <h1>{project.data.name}</h1>
  <p class="muted">{project.data.status_label} · {available} of {total} available</p>

  <h2>Availability</h2>
  <Availability buildings={buildings} />

  <h2>Units</h2>
  <form class="filters" method="get">
    <label>Rooms
      <select name="rooms" onchange="this.form.submit()">
        <option value="">All</option>
        {roomOptions.map((r) => <option value={String(r)} selected={String(r) === rooms}>{r}</option>)}
      </select>
    </label>
  </form>
  <div class="grid">{shown.map((u) => <UnitCard unit={u.data} />)}</div>
</Base>
