---
import { getCollection } from 'astro:content';
import type { PublicProject } from '@propcore/client';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects')).map((e) => e.data as PublicProject);
---
<Base title="Projects">
  <h1>Projects</h1>
  <div class="grid">
    {projects.map((p) => (
      <a class="card" href={`/projects/${p.id}`}>
        {p.media?.[0]?.url && <img src={String(p.media[0].url)} alt={p.name} loading="lazy" />}
        <strong>{p.name}</strong>
        <span class="muted">{p.status_label} · {p.unit_summary.available} of {p.unit_summary.total} available</span>
        {p.price_range?.min && <span>from {new Intl.NumberFormat('en', { style: 'currency', currency: p.currency, maximumFractionDigits: 0 }).format(Number(p.price_range.min))}</span>}
      </a>
    ))}
  </div>
</Base>
