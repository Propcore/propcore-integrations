          }
        },
        "required": ["level", "groups"],
        "additionalProperties": false
      },
      "Address": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "admin1": {
            "$ref": "#/components/schemas/AddressComponent"
          },
          "admin2": {
            "$ref": "#/components/schemas/AddressComponent"
          },
          "admin3": {
            "$ref": "#/components/schemas/AddressComponent"
          },
          "admin4": {
            "$ref": "#/components/schemas/AddressComponent"
          },
          "street": {
            "type": "string",
            "maxLength": 200
          },
          "house_number": {
            "type": "string",
            "maxLength": 50
          },
          "postal_code": {
            "type": "string",
            "maxLength": 30
          },
          "unparsed": {
            "type": "string",
            "maxLength": 500
          },
          "point": {
            "$ref": "#/components/schemas/GeoPoint"
          }
        },
        "required": ["country"],
        "additionalProperties": false
      },
      "UnitSummary": {
        "type": "object",
        "properties": {
          "available": {
            "type": "number"
          },
          "reserved": {
            "type": "number"
          },
          "sold": {
            "type": "number"
          },
          "blocked": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        },
        "required": ["available", "reserved", "sold", "blocked", "total"],
        "additionalProperties": false
      },
      "PriceRange": {
        "type": "object",
        "properties": {
          "min": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "max": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["min", "max"],
        "additionalProperties": false
      },
      "PublicStackingFloor": {
        "type": "object",
        "properties": {
          "floor_number": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicStackingCell"
            }
          }
        },
        "required": ["floor_number", "cells"],
        "additionalProperties": false
      },
      "CharacteristicGroup": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "$ref": "#/components/schemas/LabelText"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CharacteristicField"
            }
          }
        },
        "required": ["key", "label", "fields"],
        "additionalProperties": false
      },
      "AddressComponent": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": ["key", "label"],
        "additionalProperties": false
      },
      "GeoPoint": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": ["lat", "lon"],
        "additionalProperties": false
      },
      "PublicStackingCell": {
        "type": "object",
        "properties": {
          "line_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit_id": {
            "type": "string"
          },
          "unit_number": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "rooms": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "cover_url": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/PublicPrice"
          },
          "status": {
            "$ref": "#/components/schemas/PublicStatusBadge"
          }
        },
        "required": ["line_key", "status"],
        "additionalProperties": false
      },
      "CharacteristicField": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "$ref": "#/components/schemas/LabelText"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "$ref": "#/components/schemas/LabelText"
              }
            ]
          },
          "unit": {
            "type": "string"
          }
        },
        "required": ["key", "label", "value"],
        "additionalProperties": false
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
