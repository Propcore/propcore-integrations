{
  "openapi": "3.1.0",
  "info": {
    "title": "Propcore headless API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://{site}/",
      "variables": {
        "site": {
          "default": "example.propcore.page"
        }
      }
    }
